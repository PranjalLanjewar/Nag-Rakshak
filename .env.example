# Global Reliability & Mock Mode Setup
MOCK_MODE=true

# Backend Server Settings
PORT=5000
NODE_ENV=development

# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Vision AI Service Configuration (Person 3)
VISION_AI_API_KEY=your-vision-ai-api-key
VISION_AI_ENDPOINT=https://api.example.com/v1/vision

# Google Earth Engine Configuration (Person 4)
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.json
GEE_PRIVATE_KEY_PATH=./satellite/keys/gee-private-key.json
